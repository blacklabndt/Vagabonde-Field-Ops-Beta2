# Dependencies and build output — regenerated, never committed.
node_modules/
dist/
dev-dist/

# Local tool state.
.npm-cache/
.wrangler/
supabase/.temp/

# Environment files, if any ever appear. The app currently reads its
# Supabase URL and publishable key from vite-app/src/config.js — they are
# publishable by design (RLS is the security boundary), which is why the
# repo runs without a .env at all.
.env
.env.*
!.env.example

# Wrangler's local secrets file — its docs suggest putting credentials in
# it, so it must never be committable, in any variant.
.dev.vars
.dev.vars.*

# Claude Code worktrees live under the repo; never part of the project
.claude/worktrees/

# Written by `deno check` when the functions are type-checked from the root
# (see CLAUDE.md); the repo has no Deno config of its own to pin.
deno.lock

# Live bug-hunt harness and its output. The scripts probe the LIVE project and
# their logs carry real record excerpts and token columns; nothing in here is
# part of the app, and a committed log is a disclosure nobody meant to make.
vite-app/e2e/hunt/
